# ==========================================
# KONFIGURASI TELEGRAM BOT OTP EMAIL
# ==========================================

# Token Bot dari @BotFather di Telegram
BOT_TOKEN=7123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID Telegram Admin (dapatkan dari @userinfobot)
# Bisa lebih dari satu, pisahkan dengan koma jika ada beberapa admin: 12345678,87654321
ADMIN_IDS=12345678

# Harga per OTP yang berhasil masuk (Rupiah)
OTP_PRICE=200

# Minimal Top Up Saldo (Rupiah)
MIN_TOPUP=5000

# Info Pembayaran Top Up (Akan ditampilkan ke pembeli)
PAYMENT_DANA=0812-3456-7890 (a.n Nama Anda)
PAYMENT_GOPAY=0812-3456-7890 (a.n Nama Anda)
PAYMENT_OVO=0812-3456-7890 (a.n Nama Anda)
PAYMENT_BANK=BCA: 1234567890 a.n Nama Anda
PAYMENT_QRIS_URL=https://link-gambar-qris-anda.com/qris.jpg

# Konfigurasi SmailPro
# Mode headless: true = jalan di background tanpa buka jendela browser
SMAILPRO_HEADLESS=true

# (Opsional) Jika punya API Key resmi dari Smailpro / Sonjj (bisa dikosongkan jika menggunakan login browser)
SMAILPRO_API_KEY=

# AutoGoPay API Gateway (GoPay QRIS Otomatis)
AUTOGOPAY_BASE_URL=https://v1-gateway.autogopay.site
AUTOGOPAY_API_KEY=agp_masukkan_api_key_autogopay_anda_disini
